  }
}

package "modelo.util" as putil #FDF5EC {
  class ImagenUtil {
    + {static} LADO_MAXIMO : int
    + {static} TAMANO_MAXIMO_BYTES : int
    - {static} MENSAJE_NO_ES_IMAGEN : String
    - {static} CALIDADES : float[]
    - {static} FACTOR_REDUCCION : double
    - {static} MAXIMO_REDUCCIONES : int
    --
    - ImagenUtil()
    + {static} prepararEvidencia(archivo : File) : byte[]
    - {static} leerImagen(archivo : File) : BufferedImage
    - {static} redimensionar(original : BufferedImage,
    \t\tescala : double) : BufferedImage
    - {static} convertirAJpeg(imagen : BufferedImage,
    \t\tcalidad : float) : byte[]
  }
}

' ---- Herencia ----
Persona <|-- JefeCuadrilla
Persona <|-- Personal

' ---- Asociaciones entre entidades (con multiplicidad) ----
Cuadrilla "0..1" -left- "1" JefeCuadrilla : jefe
Personal "*" -left- "1" Cuadrilla : cuadrilla
Actividad "*" -up- "1" Cuadrilla : cuadrilla
Actividad "*" -right- "1..*" Colonia : colonias
Sesion -down- "0..1" Administrador : administrador

' ---- Realización de la interfaz DAO<T> ----
ActividadDAO .down.|> DAO : T = Actividad
CuadrillaDAO .down.|> DAO : T = Cuadrilla
PersonalDAO .down.|> DAO : T = Personal
AdministradorDAO .up.|> DAO : T = Administrador
ColoniaDAO .up.|> DAO : T = Colonia
JefeCuadrillaDAO .up.|> DAO : T = JefeCuadrilla

' ---- Dependencias ----
pdao ..> ConexionBD
ActividadDAO ..> ResumenCuadrilla : <<crea>>

' ---- Acomodo (enlaces ocultos) ----
Administrador -[hidden]right- Persona
Persona -[hidden]right- ResumenCuadrilla
ResumenCuadrilla -[hidden]right- DAO
ActividadDAO -[hidden]right- CuadrillaDAO
CuadrillaDAO -[hidden]right- PersonalDAO
AdministradorDAO -[hidden]right- ColoniaDAO
ColoniaDAO -[hidden]right- JefeCuadrillaDAO
AdministradorDAO -[hidden]down- ConexionBD
Contrasenas -[hidden]down- Persona
ImagenUtil -[hidden]down- ResumenCuadrilla
Sesion -[hidden]right- Contrasenas
Contrasenas -[hidden]right- ImagenUtil

legend bottom right
  <b>Notación</b>
  + público    - privado    # protegido    <u>subrayado</u>: estático    <i>cursiva</i>: abstracto
  Flecha con triángulo continua: herencia    Flecha con triángulo punteada: realización de interfaz
  Línea continua: asociación (multiplicidad en cada extremo y nombre del atributo)    Flecha punteada: dependencia
  «Singleton»: clase con una sola instancia, que se obtiene con getInstancia()
  <b>Modificadores que no se dibujan</b>
  Sesion, ConexionBD, Contrasenas e ImagenUtil son clases final (constructor privado, no se heredan).
  Los atributos en MAYÚSCULAS son constantes static final; los atributos de ResumenCuadrilla y ConexionBD.conexion son final.
  Excepciones: ConexionBD(), getInstancia() y leerConfiguracion() lanzan SQLException; prepararEvidencia(), leerImagen() y convertirAJpeg() lanzan IOException.
endlegend

@enduml
