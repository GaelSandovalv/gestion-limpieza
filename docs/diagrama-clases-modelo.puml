package "modelo" as pmodelo #F4F9FD {

  class Administrador {
    - id : int
    - usuario : String
    - contrasenaHash : String
    - nombre : String
    --
    + Administrador()
    + Administrador(id : int, usuario : String,
    \t\tcontrasenaHash : String, nombre : String)
    + getId() : int
    + setId(id : int) : void
    + getUsuario() : String
    + setUsuario(usuario : String) : void
    + getContrasenaHash() : String
    + setContrasenaHash(contrasenaHash : String) : void
    + getNombre() : String
    + setNombre(nombre : String) : void
    + toString() : String
  }

  abstract class Persona <<abstract>> {
    - id : int
    - nombre : String
    - apellidos : String
    --
    # Persona()
    # Persona(id : int, nombre : String, apellidos : String)
    + getId() : int
    + setId(id : int) : void
    + getNombre() : String
    + setNombre(nombre : String) : void
    + getApellidos() : String
    + setApellidos(apellidos : String) : void
    + getNombreCompleto() : String
    + toString() : String
  }

  class ResumenCuadrilla {
    - cuadrillaId : int
    - nombreCuadrilla : String
    - nombreJefe : String
    - numPersonal : int
    - numActividades : int
    --
    + ResumenCuadrilla(cuadrillaId : int,
    \t\tnombreCuadrilla : String, nombreJefe : String,
    \t\tnumPersonal : int, numActividades : int)
    + getCuadrillaId() : int
    + getNombreCuadrilla() : String
    + getNombreJefe() : String
    + getNumPersonal() : int
    + getNumActividades() : int
  }

  class JefeCuadrilla {
    + JefeCuadrilla()
    + JefeCuadrilla(id : int, nombre : String,
    \t\tapellidos : String)
  }

  class Cuadrilla {
    - id : int
    - nombre : String
    - jefe : JefeCuadrilla
    --
    + Cuadrilla()
    + Cuadrilla(id : int, nombre : String,
    \t\tjefe : JefeCuadrilla)
    + getId() : int
    + setId(id : int) : void
    + getNombre() : String
    + setNombre(nombre : String) : void
    + getJefe() : JefeCuadrilla
    + setJefe(jefe : JefeCuadrilla) : void
    + toString() : String
  }

  class Personal {
    - cuadrilla : Cuadrilla
    --
    + Personal()
    + Personal(id : int, nombre : String,
    \t\tapellidos : String, cuadrilla : Cuadrilla)
    + getCuadrilla() : Cuadrilla
    + setCuadrilla(cuadrilla : Cuadrilla) : void
  }

  class Actividad {
    - id : int
    - nombre : String
    - detalle : String
    - fecha : LocalDate
    - lugar : String
    - cuadrilla : Cuadrilla
    - colonias : List<Colonia>
    - evidencia : byte[]
    --
    + Actividad()
    + Actividad(id : int, nombre : String, detalle : String,
    \t\tfecha : LocalDate, lugar : String, cuadrilla : Cuadrilla)
    + getId() : int
    + setId(id : int) : void
    + getNombre() : String
    + setNombre(nombre : String) : void
    + getDetalle() : String
    + setDetalle(detalle : String) : void
    + getFecha() : LocalDate
    + setFecha(fecha : LocalDate) : void
    + getLugar() : String
    + setLugar(lugar : String) : void
    + getCuadrilla() : Cuadrilla
    + setCuadrilla(cuadrilla : Cuadrilla) : void
    + getColonias() : List<Colonia>
    + setColonias(colonias : List<Colonia>) : void
    + getEvidencia() : byte[]
    + setEvidencia(evidencia : byte[]) : void
  }

  class Colonia {
    - id : int
    - codigoPostal : String
    - nombre : String
    - tipoAsentamiento : String
    --
    + Colonia()
    + Colonia(id : int, codigoPostal : String,
    \t\tnombre : String, tipoAsentamiento : String)
    + getId() : int
    + setId(id : int) : void
    + getCodigoPostal() : String
    + setCodigoPostal(codigoPostal : String) : void
    + getNombre() : String
    + setNombre(nombre : String) : void
    + getTipoAsentamiento() : String
    + setTipoAsentamiento(tipoAsentamiento : String) : void
    + toString() : String
  }
}

package "modelo.dao" as pdao #F3FAF4 {

  interface "DAO<T>" as DAO <<interface>> {
    + insertar(objeto : T) : void
    + actualizar(objeto : T) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : T
    + listar() : List<T>
  }

  note right of DAO
    Todos los métodos de los DAO
    lanzan SQLException.
  end note

  class AdministradorDAO {
    - {static} COLUMNAS : String
    --
    + insertar(administrador : Administrador) : void
    + actualizar(administrador : Administrador) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : Administrador
    + listar() : List<Administrador>
    + buscarPorUsuario(usuario : String) : Administrador
    - mapear(rs : ResultSet) : Administrador
    - conexion() : Connection
  }

  class ColoniaDAO {
    - {static} COLUMNAS : String
    --
    + insertar(colonia : Colonia) : void
    + actualizar(colonia : Colonia) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : Colonia
    + listar() : List<Colonia>
    + buscar(texto : String) : List<Colonia>
    - mapear(rs : ResultSet) : Colonia
    - conexion() : Connection
  }

  class JefeCuadrillaDAO {
    - {static} COLUMNAS : String
    --
    + insertar(jefe : JefeCuadrilla) : void
    + actualizar(jefe : JefeCuadrilla) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : JefeCuadrilla
    + listar() : List<JefeCuadrilla>
    - mapear(rs : ResultSet) : JefeCuadrilla
    - conexion() : Connection
  }

  class ActividadDAO {
    - {static} CONSULTA_LIGERA : String
    - {static} ORDEN : String
    --
    + insertar(actividad : Actividad) : void
    + actualizar(actividad : Actividad) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : Actividad
    + listar() : List<Actividad>
    + listarPorCuadrilla(cuadrillaId : int) : List<Actividad>
    + resumenPorCuadrilla() : List<ResumenCuadrilla>
    + contarTotal() : int
    - asignarDatos(ps : PreparedStatement,
    \t\tactividad : Actividad) : void
    - insertarColonias(con : Connection, actividadId : int,
    \t\tcolonias : List<Colonia>) : void
    - listarColonias(actividadId : int) : List<Colonia>
    - mapear(rs : ResultSet) : Actividad
    - conexion() : Connection
  }

  class CuadrillaDAO {
    - {static} CONSULTA : String
    --
    + insertar(cuadrilla : Cuadrilla) : void
    + actualizar(cuadrilla : Cuadrilla) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : Cuadrilla
    + listar() : List<Cuadrilla>
    - mapear(rs : ResultSet) : Cuadrilla
    - conexion() : Connection
  }

  class PersonalDAO {
    - {static} CONSULTA : String
    --
    + insertar(personal : Personal) : void
    + actualizar(personal : Personal) : void
    + eliminar(id : int) : void
    + buscarPorId(id : int) : Personal
    + listar() : List<Personal>
    - mapear(rs : ResultSet) : Personal
    - conexion() : Connection
  }
}

package "modelo.conexion" as pconexion #FDF5EC {
  class ConexionBD <<Singleton>> {
    - {static} ARCHIVO_CONFIGURACION : String
    - {static} SEGUNDOS_VALIDACION : int
    - {static} instancia : ConexionBD
    - conexion : Connection
    --
    - ConexionBD()
    + {static} getInstancia() : ConexionBD
    + getConexion() : Connection
    + {static} cerrar() : void
    - {static} leerConfiguracion() : Properties
  }

  note right of ConexionBD
    Dependencia «usa» desde modelo.dao:
    cada DAO obtiene la conexión con
    ConexionBD.getInstancia().getConexion()
    en su método privado conexion().
  end note
}

package "modelo.seguridad" as pseguridad #FDF5EC {
  class Contrasenas {
    - {static} ALGORITMO : String
    - {static} ITERACIONES : int
    - {static} LONGITUD_HASH_BITS : int
    - {static} TAMANO_SAL : int
    - {static} SEPARADOR : String
